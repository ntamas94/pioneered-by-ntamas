<Template>
  <WidgetGroup>
    <SizePolicy>me,e</SizePolicy>
    <Layout>vertical</Layout>
    <Children>
      <WidgetGroup>
        <ObjectName>LibraryWrapper</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>SidebarContainer</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,40max</Size>
            <Children>
              <SearchBox>
                <ObjectName>SearchBox</ObjectName>
                <Size>0me,40max</Size>
              </SearchBox>
              <PushButton>
                <ObjectName>SidebarButton</ObjectName>
                <Size>80p,40p</Size>
                <NumberStates>1</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>&#9000; KBD</Text>
                </State>
                <Connection>
                  <ConfigKey>[Pioneered],osk</ConfigKey>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>SidebarButton</ObjectName>
                <Size>80p,40p</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>Show &#8612;</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>Hide &#8614;</Text>
                </State>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <SizePolicy>me,me</SizePolicy>
            <Layout>horizontal</Layout>
            <Size>0me,0me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>LibraryWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Children>
                  <Library>
                    <ObjectName>Library</ObjectName>
                    <Size>0me,0me</Size>
                    <BgColor>#000</BgColor>
                    <FgColor>#75001a</FgColor>
                    <TrackTableBackgroundColorOpacity>0.4</TrackTableBackgroundColorOpacity>
                  </Library>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SidebarWrapper</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <LibrarySidebar>
                    <ObjectName>LibrarySidebar</ObjectName>
                    <Size>0me,0me</Size>
                  </LibrarySidebar>
                </Children>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,max</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>DeckRowTop</ObjectName>
            <Connection>
              <ConfigKey>[Pioneered],show_cardtop</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
            <Layout>horizontal</Layout>
            <Size>0me,160max</Size>
            <Children>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">1</SetVariable>
                <SetVariable name="ovh">116</SetVariable>
                <SetVariable name="ovwf">188</SetVariable>
              </Template>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">2</SetVariable>
                <SetVariable name="ovh">116</SetVariable>
                <SetVariable name="ovwf">188</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>DeckRowBottom</ObjectName>
            <Connection>
              <ConfigKey>[Pioneered],show_cardbot</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
            <Layout>horizontal</Layout>
            <Size>0me,160max</Size>
            <Children>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">3</SetVariable>
                <SetVariable name="ovh">116</SetVariable>
                <SetVariable name="ovwf">188</SetVariable>
              </Template>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">4</SetVariable>
                <SetVariable name="ovh">116</SetVariable>
                <SetVariable name="ovwf">188</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
